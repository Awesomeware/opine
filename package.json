{
  "name": "opine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test",
    "test:integration": "node scripts/run-database-suites.ts integration",
    "test:e2e": "pnpm build && node scripts/run-database-suites.ts e2e",
    "layer:new": "nuxt add-template layer",
    "auth:role": "node scripts/auth-role.ts",
    "feedback:category": "node scripts/feedback-category.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "node scripts/database.ts seed",
    "db:reset": "node scripts/database.ts reset",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test:ui": "pnpm storybook:build && playwright test --config .storybook/playwright.config.ts",
    "storybook:typecheck": "vue-tsc --noEmit -p .storybook/tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "nuxt": "4.6.4",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/vue3-vite": "10.6.7",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "6.0.11",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "storybook": "10.6.7",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26.7.0 <27",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
