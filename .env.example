# Local Docker Compose credentials only; use deployment secrets in production.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://opine:opine@127.0.0.1:5432/opine

# Public installation settings (never put secrets here). See docs/community.md.
# Empty name/rules use the built-in defaults; an empty URL hides the community link.
NUXT_PUBLIC_COMMUNITY_NAME=Community
NUXT_PUBLIC_COMMUNITY_URL=
# Plain text; double-quoted values can span multiple lines.
NUXT_PUBLIC_COMMUNITY_RULES=

# Discord OAuth callback: http://localhost:3000/api/auth/callback/discord
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Sign-in requests per client IP within this window (seconds).
AUTH_SIGN_IN_MAX=10
AUTH_SIGN_IN_WINDOW_SECONDS=60

# Minimum interval between successful feedback posts per member (seconds).
FEEDBACK_POST_WINDOW_SECONDS=60

# Successful comments and official responses per member within the window.
FEEDBACK_COMMENT_MAX=10
FEEDBACK_RESPONSE_MAX=20
FEEDBACK_PARTICIPATION_WINDOW_SECONDS=60
