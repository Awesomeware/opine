# Local Docker Compose credentials only; use deployment secrets in production.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://opine:opine@127.0.0.1:5432/opine

# Discord OAuth callback: http://localhost:3000/api/auth/callback/discord
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Sign-in requests per client IP within this window (seconds).
AUTH_SIGN_IN_MAX=10
AUTH_SIGN_IN_WINDOW_SECONDS=60

# Successful feedback submissions per member within this window (seconds).
FEEDBACK_POST_MAX=5
FEEDBACK_POST_WINDOW_SECONDS=60

# Successful new participation requests per member (retries reuse their receipt).
FEEDBACK_COMMENT_MAX=10
FEEDBACK_REACTION_MAX=30
FEEDBACK_EDIT_MAX=20
FEEDBACK_RESPONSE_MAX=20
FEEDBACK_FOLLOW_MAX=30
FEEDBACK_PARTICIPATION_WINDOW_SECONDS=60
